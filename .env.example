# Copy to .env for local dev. These defaults run with zero external secrets.
PORT=3000
DATABASE_URL=postgres://folio:folio@localhost:5433/folio

# Self-issued session token secret (any random string locally).
SESSION_JWT_SECRET=dev-secret-change-me

# Accept { dev_user, handle } logins with no Apple identity token. Local only.
AUTH_DEV_BYPASS=true

# Apple audience (bundle id) — only needed when AUTH_DEV_BYPASS=false.
APPLE_CLIENT_ID=com.thedoidea.co.Folio

# Base URL used to build invite links.
PUBLIC_BASE_URL=http://localhost:3000

# Extraction: stub keeps the pending->processing->ready loop with no secrets.
EXTRACTION_MODE=stub
